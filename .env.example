# Database
DATABASE_URL=postgresql+asyncpg://gateway:secret@localhost/gateway

# Telegram Bots
ADDER_BOT_TOKEN=123456:ABC-DEF...
PAYWATCH_BOT_TOKEN=123456:ABC-DEF...
